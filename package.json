{
  "name": "edge-secure-token",
  "version": "1.0.0",
  "description": "Zero-dependency, timing-safe WebCrypto JWT suite for Cloudflare Workers, Edge, and Node.js with field-level claims encryption.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_JA.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', {recursive: true})\" && node --test test/*.test.mjs --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info --test-reporter-destination=coverage/junit.xml"
  },
  "keywords": [
    "jwt",
    "token",
    "webcrypto",
    "edge",
    "cloudflare-workers",
    "security",
    "timing-safe",
    "field-level-encryption",
    "zero-dependencies"
  ],
  "author": "takao-dev",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
